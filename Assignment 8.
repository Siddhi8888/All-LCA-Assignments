#include <stdio.h>

void swap(int *p1, int *p2) {
    int temp = *p1;
    *p1 = *p2;
    *p2 = temp;
}

int main() {
    int motor1, motor2;
    int *ptr1 = &motor1;
    int *ptr2 = &motor2;

    printf("Enter speed of Motor 1: ");
    scanf("%d", ptr1);
    printf("Enter speed of Motor 2: ");
    scanf("%d", ptr2);

    printf("\n--- Before Swap ---\n");
    printf("Motor 1: speed = %d, address = %p\n", *ptr1, (void *)ptr1);
    printf("Motor 2: speed = %d, address = %p\n", *ptr2, (void *)ptr2);

    int old1 = *ptr1, old2 = *ptr2;

    swap(ptr1, ptr2);

    printf("\n--- After Swap ---\n");
    printf("Motor 1: speed = %d, address = %p\n", *ptr1, (void *)ptr1);
    printf("Motor 2: speed = %d, address = %p\n", *ptr2, (void *)ptr2);

    if (*ptr1 == old2 && *ptr2 == old1)
        printf("\nVerification: Swap successful!\n");
    else
        printf("\nVerification: Swap failed!\n");

    return 0;
}
